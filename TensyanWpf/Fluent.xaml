<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 字体 ============ -->
    <!-- 界面字体：Win11 的 Fluent 字体优先，逐级回退 -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, 微软雅黑, SimHei, SimSun</FontFamily>
    <!-- 官方 Fluent 图标字体（内嵌，MIT） -->
    <FontFamily x:Key="IconFont">pack://application:,,,/Fonts/#FluentSystemIcons-Regular</FontFamily>

    <!-- ============ 颜色（与手机端、WinForms 版同一套 Fluent 令牌）============ -->
    <SolidColorBrush x:Key="Bg"          Color="#F3F3F3" />
    <SolidColorBrush x:Key="Card"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="Border"      Color="#E5E5E5" />
    <SolidColorBrush x:Key="TextMain"    Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSub"     Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextFaint"   Color="#8A8A8A" />
    <SolidColorBrush x:Key="Accent"      Color="#005FB8" />
    <SolidColorBrush x:Key="AccentHover" Color="#1A6FC4" />
    <SolidColorBrush x:Key="AccentSoft"  Color="#EFF6FC" />
    <SolidColorBrush x:Key="Green"       Color="#0F7B0F" />
    <SolidColorBrush x:Key="Red"         Color="#C42B1C" />
    <SolidColorBrush x:Key="Hover"       Color="#14000000" />
    <SolidColorBrush x:Key="Pressed"     Color="#28000000" />

    <!-- ============ 渐变（层次感）============ -->
    <!-- 窗体底：上略亮下略深，制造纵深 -->
    <LinearGradientBrush x:Key="ShellGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#B8FBFCFF" Offset="0" />
        <GradientStop Color="#B4EFF2F6" Offset="1" />
    </LinearGradientBrush>
    <!-- 窗体底（不透明版）：Win10 及更早用这个，绝不留透明 -->
    <LinearGradientBrush x:Key="ShellGradientOpaque" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#F7F8FA" Offset="0" />
        <GradientStop Color="#ECEEF1" Offset="1" />
    </LinearGradientBrush>
    <!-- 左侧导航：比内容区更沉一点，形成前后关系 -->
    <LinearGradientBrush x:Key="NavGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14005FB8" Offset="0" />
        <GradientStop Color="#06FFFFFF" Offset="0.45" />
        <GradientStop Color="#0A000000" Offset="1" />
    </LinearGradientBrush>
    <!-- 标题栏：顶部高光 -->
    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- 卡片：极轻的竖向渐变，避免大平面发闷 -->
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FAFBFC" Offset="1" />
    </LinearGradientBrush>
    <!-- 强调色按钮：Fluent 主色渐变 -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0A6FC2" Offset="0" />
        <GradientStop Color="#005FB8" Offset="1" />
    </LinearGradientBrush>
    <!-- 选中态：淡蓝渐变 -->
    <LinearGradientBrush x:Key="SelectGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1F005FB8" Offset="0" />
        <GradientStop Color="#08005FB8" Offset="1" />
    </LinearGradientBrush>
    <!-- ============ 主按钮（强调色）：悬停/按压缩放+变色，全部走 WPF 合成线程 → 不撕裂 ============ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" />
                        <Border x:Name="hoverLayer" CornerRadius="4" Background="#22FFFFFF" Opacity="0" />
                        <Border x:Name="pressLayer" CornerRadius="4" Background="#33000000" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 次按钮（浅底描边）============ -->
    <Style x:Key="SubtleButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="sc2" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" />
                        <Border x:Name="hover2" CornerRadius="4" Background="#0F000000" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover2" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc2" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="sc2" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc2" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="sc2" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 导航项 ============ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6,2,6,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Height="40">
                        <Border x:Name="sel" CornerRadius="4" Background="Transparent" />
                        <Border x:Name="ind" Width="3" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{StaticResource Accent}" Opacity="0" Margin="0,8,0,8" />
                        <ContentPresenter Margin="12,0,8,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="sel" Property="Background" Value="#0F000000" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="sel" Property="Background" Value="{StaticResource SelectGradient}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ind" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ind" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 学生卡片外框 ============ -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGradient}" />
        <Setter Property="BorderBrush" Value="#1A0A1A33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Width" Value="196" />
    </Style>

</ResourceDictionary>
