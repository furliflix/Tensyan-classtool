<Window x:Class="Tensyan.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tensyan 班级积分工具"
        Width="1280" Height="800" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource ShellGradientOpaque}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <sh:WindowChrome.WindowChrome>
        <sh:WindowChrome CaptionHeight="46" ResizeBorderThickness="4"
                         GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </sh:WindowChrome.WindowChrome>

    <!-- 底色：默认不透明浅色；Win11 上由代码换成 70% 白 + 系统亚克力 -->
    <Border x:Name="RootShell" CornerRadius="0" BorderThickness="0">
        <Border.Background>
            <SolidColorBrush Color="#F3F3F3" />
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 自定义标题栏 ===== -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.Background>
                    <StaticResource ResourceKey="TitleGradient" />
                </Grid.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="5" Background="#005FB8">
                        <TextBlock Text="T" Foreground="White" FontFamily="{StaticResource UiFont}" FontWeight="Bold"
                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Text="Tensyan 班级积分工具"
                               FontFamily="{StaticResource UiFont}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            sh:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" Width="46" Height="46" Click="BtnMin_Click" ToolTip="最小化"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMain}" />
                    </Button>
                    <Button x:Name="BtnMax" Width="46" Height="46" Click="BtnMax_Click" ToolTip="最大化"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMain}" />
                    </Button>
                    <Button x:Name="BtnClose" Width="46" Height="46" Click="BtnClose_Click" ToolTip="关闭"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMain}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== 主体：左导航 + 右内容 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="Nav" Grid.Column="0" Background="{StaticResource NavGradient}" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Width="28" VerticalAlignment="Center" Foreground="{StaticResource TextMain}" />
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiFont}" FontSize="14"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMain}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#14000000" />
                <ContentControl x:Name="Host" Grid.Column="1" Margin="18,10,18,18" />
            </Grid>
        </Grid>
    </Border>
</Window>
